# HTTP server
PORT=8888

# PostgreSQL connection string
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DB_DSN=postgres://sequi:sequi@localhost:5433/sequi?sslmode=disable

# Session secret — минимум 32 символа, сменить в production
SESSION_SECRET=change-me-in-production-at-least-32-chars

# Секрет для валидации HTTP hooks от SRS
# Должен совпадать с тем, что настроен в srs.conf
SRS_HOOK_SECRET=change-me-hook-secret

# URL SRS HTTP API для получения viewer count
SRS_API_URL=http://localhost:1985/api/v1

# Директория для хранения загружаемых файлов (аватары)
MEDIA_ROOT=./uploads

# Публичный базовый URL backend — используется для формирования avatar_url
PUBLIC_BASE_URL=http://localhost:8888

# Базовый URL HLS сегментов от SRS
# Пример HLS URL: {HLS_BASE_URL}/live/{stream_key}/index.m3u8
HLS_BASE_URL=http://localhost:8080/live

# RTMP URL для OBS (только для документации, не используется кодом)
# RTMP_URL=rtmp://localhost:1935/live
